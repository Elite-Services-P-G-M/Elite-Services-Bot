# Discord Developer Portal > Bot / General Information
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Comma-separated role IDs
STAFF_ROLE_IDS=
DEVELOPER_ROLE_IDS=

# Feature access control (comma-separated role IDs). Leave blank to use defaults.
# Defaults: application review=STAFF_ROLE_IDS; tickets=STAFF_ROLE_IDS + DEVELOPER_ROLE_IDS
# duty=STAFF_ROLE_IDS; DMail=STAFF_ROLE_IDS; invoices=STAFF_ROLE_IDS; CDN=DEVELOPER_ROLE_IDS
# Members need at least one configured role. Server Administrators always bypass these checks.
APPLICATION_REVIEWER_ROLE_IDS=
TICKET_MANAGER_ROLE_IDS=
DUTY_ROLE_IDS=
DMAIL_ROLE_IDS=
INVOICE_ROLE_IDS=
CDN_ROLE_IDS=
PANEL_MANAGER_ROLE_IDS=

# Channel/category IDs
AUDIT_CHANNEL_ID=
APPLICATION_SUBMISSIONS_CHANNEL_ID=
TICKET_CATEGORY_ID=

# Local API / CDN
API_HOST=127.0.0.1
API_PORT=8787
API_KEY=replace-this-with-a-long-random-secret
PUBLIC_CDN_BASE_URL=http://localhost:8787/files

# Storage
DATABASE_PATH=./data/nexus.sqlite
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=20
